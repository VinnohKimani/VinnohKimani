name: Update README (joke + timestamp)

on:
  schedule:
    - cron: "0 6 * * *"    # daily at 06:00 UTC
  workflow_dispatch:

jobs:
  update:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4

      - name: Fetch a random dev joke
        id: joke
        run: |
          JOKE=$(curl -s https://icanhazdadjoke.com/ -H "Accept: text/plain")
          # fallback in case the API hiccups
          if [ -z "$JOKE" ]; then
            JOKE="Why do programmers prefer dark mode? Because light attracts bugs."
          fi
          echo "joke<<EOF" >> "$GITHUB_ENV"
          echo "$JOKE" >> "$GITHUB_ENV"
          echo "EOF" >> "$GITHUB_ENV"

      - name: Update README between markers
        env:
          JOKE: ${{ env.joke }}
        run: |
          DATE=$(date -u '+%Y-%m-%d %H:%M UTC')
          python3 - <<PYEOF
          import os, re

          with open("README.md", "r", encoding="utf-8") as f:
              content = f.read()

          joke = os.environ["JOKE"].strip()
          date = "${DATE}"

          content = re.sub(
              r"<!--JOKE_START-->.*?<!--JOKE_END-->",
              f"<!--JOKE_START-->\n> 😄 {joke}\n<!--JOKE_END-->",
              content, flags=re.S,
          )
          content = re.sub(
              r"<!--UPDATED_START-->.*?<!--UPDATED_END-->",
              f"<!--UPDATED_START-->\n_Last updated: {date}_\n<!--UPDATED_END-->",
              content, flags=re.S,
          )

          with open("README.md", "w", encoding="utf-8") as f:
              f.write(content)
          PYEOF

      - name: Commit and push if changed
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add README.md
          git diff --cached --quiet && echo "No changes to commit" || git commit -m "🤖 daily update: joke + timestamp"
          git push
